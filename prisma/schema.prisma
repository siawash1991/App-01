// Prisma Schema for Productivity App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  bio           String?
  avatar        String?
  language      String    @default("fa") // User's preferred language (fa/en)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  exercises          Exercise[]
  skillContents      SkillContent[]
  userProgress       UserProgress[]
  sectionCompletions SectionCompletion[]
  contentReviews     ContentReview[]
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  workoutPlans       WorkoutPlan[]
}

// Exercise Tracking
model Exercise {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  type          String    // cardio, strength, yoga, etc.
  duration      Int?      // in minutes
  calories      Int?
  distance      Float?    // in km
  sets          Int?
  reps          Int?
  weight        Float?    // in kg
  notes         String?
  completedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Skill Development Platform Models

// Skill Content (Books, Podcasts, Documentaries)
model SkillContent {
  id                  String              @id @default(cuid())
  userId              String?
  category            String              // book, podcast, documentary
  title               String
  author              String?
  description         String?
  coverImage          String?
  tags                String?             // JSON array
  difficulty          String              @default("intermediate") // beginner, intermediate, advanced
  estimatedDuration   Int?                // in minutes
  audioSummaryUrl     String?
  videoClipUrl        String?
  youtubeEmbedId      String?
  externalLink        String?
  isSystemContent     Boolean             @default(false)
  isPinned            Boolean             @default(false)
  rating              Float?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user                User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections            ContentSection[]
  progress            UserProgress[]
  reviews             ContentReview[]

  @@index([userId])
  @@index([category])
  @@index([isSystemContent])
}

// Content Sections (Book Chapters, Podcast Episodes, etc.)
model ContentSection {
  id                  String              @id @default(cuid())
  contentId           String
  sectionNumber       Int
  title               String
  content             String?             // markdown supported
  duration            Int?                // in minutes
  audioUrl            String?
  videoUrl            String?
  keyPoints           String?             // JSON array
  createdAt           DateTime            @default(now())

  skillContent        SkillContent        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  completions         SectionCompletion[]

  @@index([contentId])
  @@index([sectionNumber])
}

// User Progress Tracking
model UserProgress {
  id                  String              @id @default(cuid())
  userId              String
  contentId           String
  status              String              @default("not_started") // not_started, in_progress, completed, paused
  progressPercentage  Int                 @default(0)
  currentSection      Int                 @default(1)
  totalTimeSpent      Int                 @default(0) // in minutes
  startedAt           DateTime?
  completedAt         DateTime?
  lastAccessedAt      DateTime            @default(now())
  notes               String?
  rating              Int?                // 1-5 stars
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  content             SkillContent        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([status])
}

// Section Completion Tracking
model SectionCompletion {
  id                  String              @id @default(cuid())
  userId              String
  sectionId           String
  completed           Boolean             @default(false)
  timeSpent           Int?                // in minutes
  notes               String?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  section             ContentSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

// Content Reviews and Ratings
model ContentReview {
  id                  String              @id @default(cuid())
  userId              String
  contentId           String
  rating              Int                 // 1-5 stars
  review              String?
  isRecommended       Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  content             SkillContent        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([rating])
}

// Progress Posts (Social Feed)
model Post {
  id            String    @id @default(cuid())
  userId        String
  language      String    @default("fa") // Language of the post
  title         String
  content       String
  category      String    // exercise, book, general, achievement
  images        String?   // JSON array of image URLs
  visibility    String    @default("public") // public, private, friends
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         Like[]

  @@index([userId])
  @@index([createdAt])
  @@index([language])
}

// Comments on Posts
model Comment {
  id            String    @id @default(cuid())
  postId        String
  userId        String
  content       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

// Likes on Posts
model Like {
  id            String    @id @default(cuid())
  postId        String
  userId        String
  createdAt     DateTime  @default(now())

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ============================================
// Workout Tracking System (New)
// ============================================

// Daily Workout Plan
model WorkoutPlan {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime
  targetReps      Int       @default(100)
  timeLimit       Int       @default(60)   // in minutes
  status          String    @default("pending") // pending, in_progress, completed, skipped
  startedAt       DateTime?
  completedAt     DateTime?
  totalDuration   Int?      // in minutes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       DailyExercise[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// Daily Exercise (per workout type)
model DailyExercise {
  id              String    @id @default(cuid())
  workoutPlanId   String
  exerciseType    String    // pushup, pullup, squat, situp
  targetReps      Int       @default(100)
  completedReps   Int       @default(0)
  status          String    @default("pending") // pending, completed, skipped
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workoutPlan     WorkoutPlan      @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  sets            ExerciseSet[]

  @@index([workoutPlanId])
  @@index([exerciseType])
}

// Individual Exercise Sets
model ExerciseSet {
  id                String    @id @default(cuid())
  dailyExerciseId   String
  setNumber         Int
  reps              Int
  restTime          Int?      // in seconds
  createdAt         DateTime  @default(now())

  dailyExercise     DailyExercise  @relation(fields: [dailyExerciseId], references: [id], onDelete: Cascade)

  @@index([dailyExerciseId])
}
